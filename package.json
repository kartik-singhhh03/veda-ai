{
  "name": "vedaai-assessment-mapping",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo run build --filter=@vedaai/web",
    "start": "npm --workspace @vedaai/web run start",
    "lint": "turbo lint",
    "test": "turbo test"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.8.1",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "10.8.1",
      "onFail": "ignore"
    }
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
