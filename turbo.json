{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "GEMINI_API_KEY",
    "GEMINI_EXTRACTION_MODEL",
    "GEMINI_MODEL"
  ],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "GEMINI_API_KEY",
        "GEMINI_EXTRACTION_MODEL",
        "GEMINI_MODEL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {}
  }
}
