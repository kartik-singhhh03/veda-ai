{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "turbo run build --filter=@vedaai/web",
  "outputDirectory": "apps/web/.next",
  "functions": {
    "apps/web/app/api/extract-questions/route.ts": {
      "maxDuration": 60
    },
    "apps/web/app/api/extract-answers/route.ts": {
      "maxDuration": 60
    },
    "apps/web/app/api/map-answers/route.ts": {
      "maxDuration": 60
    },
    "apps/web/app/api/grade/route.ts": {
      "maxDuration": 30
    }
  }
}
